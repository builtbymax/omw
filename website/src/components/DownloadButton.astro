---
import { downloadUrl } from '../config';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={downloadUrl}
  data-magnetic
  class:list={[
    'glass relative isolate inline-flex rounded-full px-6.5 text-[16px] leading-5 font-semibold text-black',
    className,
  ]}
>
  <span data-magnetic-label class="label-shift flex items-center gap-2.5">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M3 14h10"
        fill="none"
        stroke="#000000"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Download for macOS
  </span>
</a>

<style>
  /* Liquid glass: an even fill, a dark hairline and a bright inner rim that catches light at the bottom. */
  .glass {
    background: linear-gradient(180deg, rgb(246 247 249 / 0.94), rgb(228 230 235 / 0.9));
    backdrop-filter: blur(14px) saturate(1.8);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.38),
      inset 0 0 0 2.5px rgb(255 255 255 / 0.6),
      inset 0 -3px 2px -1px rgb(255 255 255 / 0.95),
      inset 0 2px 1px -1px rgb(255 255 255),
      0 0 0 1px rgb(255 255 255 / 0.2),
      0 10px 28px -10px rgb(255 255 255 / 0.2);
    transform: translate3d(var(--mx, 0px), var(--my, 0px), 0);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.9, 0.25, 1),
      box-shadow 0.3s ease;
  }

  /* Soft highlight that follows the pointer. */
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(80px circle at var(--px, 50%) var(--py, 0%), rgb(255 255 255 / 0.75), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glass:hover {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.38),
      inset 0 0 0 2.5px rgb(255 255 255 / 0.6),
      inset 0 -3px 2px -1px rgb(255 255 255 / 0.95),
      inset 0 2px 1px -1px rgb(255 255 255),
      0 0 0 1px rgb(255 255 255 / 0.35),
      0 14px 36px -10px rgb(255 255 255 / 0.3);
  }

  .glass:hover::before {
    opacity: 1;
  }

  .label-shift {
    transform: translate3d(var(--lx, 0px), var(--ly, 0px), 0);
    transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.25, 1);
  }

  .glass.is-pulled,
  .glass.is-pulled .label-shift {
    transition-duration: 0.15s;
  }
</style>

<script>
  // Pulls the button towards the pointer once it comes close, the label a bit further.
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHover && !reducedMotion) {
    const buttons = [...document.querySelectorAll<HTMLElement>('[data-magnetic]')];
    let frame = 0;

    window.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        for (const button of buttons) {
          const label = button.querySelector<HTMLElement>('[data-magnetic-label]');
          const rect = button.getBoundingClientRect();
          // Measure from the resting position, not the pulled one.
          const shiftX = parseFloat(button.style.getPropertyValue('--mx')) || 0;
          const shiftY = parseFloat(button.style.getPropertyValue('--my')) || 0;
          const centerX = rect.left - shiftX + rect.width / 2;
          const centerY = rect.top - shiftY + rect.height / 2;
          const dx = event.clientX - centerX;
          const dy = event.clientY - centerY;
          const reach = rect.width / 2 + 16;

          if (Math.hypot(dx, dy) < reach) {
            button.classList.add('is-pulled');
            button.style.setProperty('--mx', `${dx * 0.025}px`);
            button.style.setProperty('--my', `${dy * 0.04}px`);
            label?.style.setProperty('--lx', `${dx * 0.01}px`);
            label?.style.setProperty('--ly', `${dy * 0.015}px`);
            button.style.setProperty('--px', `${event.clientX - rect.left}px`);
            button.style.setProperty('--py', `${event.clientY - rect.top}px`);
          } else if (button.classList.contains('is-pulled')) {
            button.classList.remove('is-pulled');
            for (const name of ['--mx', '--my']) button.style.removeProperty(name);
            for (const name of ['--lx', '--ly']) label?.style.removeProperty(name);
          }
        }
      });
    });
  }
</script>
