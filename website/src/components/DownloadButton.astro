---
import { downloadUrl } from '../config';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={downloadUrl}
  data-glass
  class:list={[
    'glass relative isolate inline-flex items-center gap-2.5 rounded-full px-6.5 text-[16px] leading-5 font-semibold text-black',
    className,
  ]}
>
  <svg class="slide-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M3 14h10"
      fill="none"
      stroke="#000000"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="slide-label whitespace-nowrap">Download for macOS</span>
  <svg class="slide-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M2.5 8h11m-4.5-4.5L13.5 8 9 12.5"
      fill="none"
      stroke="#000000"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  /* Liquid glass: an even fill, a dark hairline and a bright inner rim that catches light at the bottom. */
  .glass {
    background: linear-gradient(180deg, rgb(246 247 249 / 0.94), rgb(228 230 235 / 0.9));
    backdrop-filter: blur(14px) saturate(1.8);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.38),
      inset 0 0 0 2.5px rgb(255 255 255 / 0.6),
      inset 0 -3px 2px -1px rgb(255 255 255 / 0.95),
      inset 0 2px 1px -1px rgb(255 255 255),
      0 0 0 1px rgb(255 255 255 / 0.2),
      0 10px 28px -10px rgb(255 255 255 / 0.2);
    transition: box-shadow 0.3s ease;
  }

  /* Soft highlight that follows the pointer. */
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(80px circle at var(--px, 50%) var(--py, 0%), rgb(255 255 255 / 0.75), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glass:hover {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.38),
      inset 0 0 0 2.5px rgb(255 255 255 / 0.6),
      inset 0 -3px 2px -1px rgb(255 255 255 / 0.95),
      inset 0 2px 1px -1px rgb(255 255 255),
      0 0 0 1px rgb(255 255 255 / 0.35),
      0 14px 36px -10px rgb(255 255 255 / 0.3);
  }

  .glass:hover::before {
    opacity: 1;
  }

  /* Sliding blur, after atlasformac.com: the icon blurs out to the left, the label follows and an arrow blurs in on the right. */
  .slide-icon,
  .slide-label,
  .slide-arrow {
    transition:
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 300ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .slide-arrow {
    position: absolute;
    right: 26px;
    opacity: 0;
    filter: blur(8px);
    transform: translateX(100%) scaleX(0.5);
  }

  .glass:is(:hover, :focus-visible) .slide-icon {
    opacity: 0;
    filter: blur(8px);
    transform: translateX(-100%) scaleX(0.5);
  }

  /* Icon width plus the gap. */
  .glass:is(:hover, :focus-visible) .slide-label {
    transform: translateX(-26px);
  }

  .glass:is(:hover, :focus-visible) .slide-arrow {
    opacity: 1;
    filter: blur(0);
    transform: translateX(0) scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-icon,
    .slide-label,
    .slide-arrow {
      transition-duration: 0ms;
    }
  }
</style>

<script>
  // Moves the glass highlight with the pointer.
  for (const button of document.querySelectorAll<HTMLElement>('[data-glass]')) {
    button.addEventListener('pointermove', (event) => {
      const rect = button.getBoundingClientRect();
      button.style.setProperty('--px', `${event.clientX - rect.left}px`);
      button.style.setProperty('--py', `${event.clientY - rect.top}px`);
    });
  }
</script>
